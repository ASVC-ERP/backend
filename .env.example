# ============================================================================
#  IMS backend — environment
#  Copy to .env for local dev. On a host (Render, etc.) set these as the
#  service's environment variables instead of committing a file.
# ============================================================================

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_KEY=your-anon-key

# --- Auth ----------------------------------------------------------------
# generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- AI insights (Reports > Sales/Purchases "AI Insights" button) --------
# Free key from https://aistudio.google.com/apikey -- leave blank to disable.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Misc ----------------------------------------------------------------
DB_NAME=dev

# development | production
#   production: adds Secure to the refresh-token cookie
NODE_ENV=development

# PORT is supplied by the host (Render, etc.); falls back to 3000 locally.
# PORT=3000

# Allowed frontend origin(s), comma-separated. Only needed when the frontend is
# served from a DIFFERENT origin than this API. Leave blank when the built
# frontend is copied into ./public (same origin).
#   dev + blank  -> any origin reflected
#   prod + blank -> CORS disabled (same-origin only)
# CORS_ORIGIN=https://ims.example.com,https://staging.ims.example.com


# ============================================================================
#  Production deploy on Render (backend serves the built frontend from ./public)
# ----------------------------------------------------------------------------
#  Set these as the Render service's Environment Variables:
#
#    SUPABASE_URL               = https://<your-project>.supabase.co
#    SUPABASE_SERVICE_ROLE_KEY  = <service-role key>
#    SUPABASE_KEY               = <anon/secret key>
#    JWT_SECRET                 = <long random string, >= 32 chars>
#    NODE_ENV                   = production
#    DB_NAME                    = dev
#
#  Do NOT set:
#    PORT         - Render injects it; the app reads process.env.PORT
#    CORS_ORIGIN  - frontend is same-origin (served from ./public), so no CORS
#
#  Before building the frontend for this deploy, set in ims-frontend/.env:
#    VITE_API_URL=/api            (relative — same origin as the backend)
#  then build and copy dist/ into ims-backend/public/.
#
#  Runtime: Node >= 22 (see .nvmrc / package.json "engines"). While the deploy
#  box was on Node 19 two deps were pinned:
#    @nestjs/mapped-types 2.1.0, @supabase/supabase-js 2.94.0
#  On Node 22 those can go back to ^-ranges — then `bun install` + test.
# ============================================================================
